---
import '../assets/css/bootstrap-5.3.8.min.css';
import '../assets/css/style.css';
import bootstrapJs from '../assets/js/bootstrap.bundle-5.3.8.min.js?url';
import heading from '../assets/heading.png';
import chlorisFigure from '../assets/chloris-figure.png';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const withBase = (path) => `${basePath}${path.replace(/^\//, '')}`;
const navItems = [
  { href: 'description/', label: 'Description' },
  { href: 'species/', label: 'Species' },
  { href: 'proteins/', label: 'Proteins' },
  { href: 'phylogeny/', label: 'Phylogeny' },
  { href: 'download/', label: 'Download' },
  { href: 'credits/', label: 'Credits' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chloris</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <section class="hero">
      <header class="site-header">
        <nav class="nav">
          {navItems.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
        </nav>
      </header>

      <div class="hero-content">
        <h1 class="title"><img src={heading.src} alt="Chloris" /></h1>

        <h2 class="subtitle">
          Chloroplast Ortholog Resources<br />
          and Identification Suite
        </h2>

        <p class="description">
          Chloris is a curated resource using annotated genes of complete algal chloroplast genomes,
          designed to use orthologous genes to support research in evolution, phylogeny, and photosynthetic diversity.
        </p>

        <a href={withBase('description/')} class="cta">
          Explore the database ->
        </a>
      </div>

      <img src={chlorisFigure.src} alt="Chloris figure" class="chloris-figure" />
    </section>

    <script src={bootstrapJs}></script>
  </body>
</html>
