---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('docs', ({ id }) => id.startsWith('proteins/'));

  return pages.map((page) => ({
    params: { protein: page.id.replace('proteins/', '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const title = page.data.title || page.id.replace('proteins/', '');
const description = page.data.description || 'Protein details, alignment, and structure';
---

<DocsLayout title={title} description={description}>
  <Content />
</DocsLayout>
