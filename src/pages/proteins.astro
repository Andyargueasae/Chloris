---
import { getCollection, getEntry, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

const page = await getEntry('docs', 'proteins');
if (!page) {
  throw new Error('Missing docs entry: proteins');
}
const { Content } = await render(page);
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const withBase = (path: string) => `${basePath}${path.replace(/^\//, '')}`;

const proteinPages = (await getCollection('docs', ({ id }) => id.startsWith('proteins/'))).sort(
  (a, b) => {
    const aTitle = a.data.title || a.id.replace('proteins/', '');
    const bTitle = b.data.title || b.id.replace('proteins/', '');
    return aTitle.localeCompare(bTitle, undefined, { sensitivity: 'base' });
  }
);

const proteins = proteinPages.map((entry) => {
  const protein = entry.id.replace('proteins/', '');
  return {
    protein,
    title: entry.data.title || protein,
    href: withBase(`proteins/${protein}/`),
  };
});
---

<DocsLayout title={page.data.title} description={page.data.description}>
  <Content />

  <h2>protein List ({proteins.length})</h2>

  <ul class="protein-list">
    {
      proteins.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a>
        </li>
      ))
    }
  </ul>

  <style>
    .protein-list {
      columns: 3;
      column-gap: 2rem;
      padding-left: 1.25rem;
    }

    .protein-list li {
      break-inside: avoid;
      margin-bottom: 0.3rem;
    }

    @media (max-width: 900px) {
      .protein-list {
        columns: 2;
      }
    }

    @media (max-width: 640px) {
      .protein-list {
        columns: 1;
      }
    }
  </style>
</DocsLayout>
