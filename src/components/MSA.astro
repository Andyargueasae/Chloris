---
export interface Props {
  viewerId?: string;
  fastaUrl?: string;        // e.g. /alignments/rbcL.aln (under /public)
  fasta?: string;           // OR inline aligned FASTA
  annotations?: any[];
  alterations?: any[];
  colorSchema?: string;     // "clustal", etc.
  hasConsensus?: boolean;
  exportName?: string;      // e.g., "rbcL_alignment.fasta"
}

const {
  viewerId = "MSABrowserDemo",
  fastaUrl,
  fasta,
  annotations = [],
  alterations = [],
  colorSchema = "clustal",
  hasConsensus = true,
  exportName = ""
} = Astro.props;
---

<!-- Container holds config in data-* so /public/js/msa-viewer.js can read it -->
<section
  id={viewerId}
  data-msa
  data-fasta-url={fastaUrl ?? ""}
  data-inline-fasta={fasta ?? ""}
  data-annotations={JSON.stringify(annotations)}
  data-alterations={JSON.stringify(alterations)}
  data-color-schema={colorSchema}
  data-has-consensus={hasConsensus}
  data-export-name={exportName}
/>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/msabrowser/msabrowser@v1.1/css/style.css" />
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<!-- External, non-inline init (CSP-friendly) -->
<script defer src="/js/msa-viewer.js"></script>
