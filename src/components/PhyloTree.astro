---
const { dataUrl } = Astro.props;
---

<div class="tree-wrapper">
  <!-- 必须给容器设置明确的宽高 -->
  <div id="tree-container" data-url={dataUrl} style="width: 100%; height: 800px; min-height: 800px; position: relative;">
    <p id="loading-msg">正在加载进化树数据...</p>
  </div>
</div>

<script>
  import { phylotree } from "phylotree";
  import * as d3 from "d3";
  // 必须引入基础样式，否则树的线条是透明的
  import "phylotree/dist/phylotree.css";

  async function renderTree() {
    const el = document.querySelector("#tree-container");
    const loading = document.querySelector("#loading-msg");
    const url = el.dataset.url;

    try {
      const response = await fetch(url);
      const newick = await response.text();
      
      // 清空容器，防止重复渲染
      el.innerHTML = "";

      const tree = new phylotree(newick);
      
      // 关键：在 861 个节点的情况下，建议启用 align-tips 和 zoom
      const renderer = tree.render({
        container: "#tree-container",
        width: el.clientWidth || 800,
        height: 800,
        "align-tips": true,
        zoom: true,
        "left-right-spacing": "fit-to-size",
        "top-bottom-spacing": "fit-to-size"
      });

      // 强制触发一次更新
      renderer.update();

    } catch (err) {
      el.innerHTML = `<p style="color: red;">渲染失败: ${err.message}</p>`;
      console.error(err);
    }
  }

  // 确保在页面加载后运行
  window.addEventListener('load', renderTree);
</script>

<style>
  /* 解决 MDX 环境下可能存在的 SVG 溢出隐藏问题 */
  #tree-container :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible !important;
  }
</style>
